# Copy this file to .env (in the same folder) to use your own Stack Exchange key.
# Get a free key at https://stackapps.com/apps/oauth/register
#
# Without a key, Stack Overflow allows 300 requests a day per IP address,
# shared by everyone on the same network. With a key it's 10,000 a day.
# .env is in .gitignore, so your key is never committed.
STACKEXCHANGE_KEY=
